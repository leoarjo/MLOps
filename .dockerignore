mlflow.db
mlruns/
mlartifacts/

# o que não é necessário para treinar
tests/
Dockerfile
.dockerignore
compose.yml

# serving (Encontro 12): tem imagem própria, com Dockerfile.serve
Dockerfile.serve
*.dockerignore
compose.serve.yml
.streamlit/
